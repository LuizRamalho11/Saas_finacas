# Todas as variáveis abaixo são validadas em lib/env.ts na partida do servidor.
# Se alguma faltar ou estiver malformada, o servidor não sobe e diz qual é.

# Conexão do PostgreSQL. Troque livremente por Neon, Supabase ou um Postgres próprio.
DATABASE_URL="postgresql://finora:finora@localhost:55432/finora?schema=public"

# Segredo de assinatura das sessões. Gere o seu com: openssl rand -base64 32
# Mínimo de 32 caracteres. Nunca reaproveite o segredo de produção em dev.
AUTH_SECRET="gere-o-seu-com-openssl-rand-base64-32-caracteres"

# Confiar no cabeçalho Host da requisição. "true" em desenvolvimento e atrás de
# um proxy confiável (Vercel); "false" quando o app é exposto direto na internet.
AUTH_TRUST_HOST=true

# URL pública da aplicação, usada em redirecionamentos e e-mails.
# Opcional em desenvolvimento (o padrão é http://localhost:3000); em produção
# precisa ser a URL real — localhost é recusado.
APP_URL="http://localhost:3000"
